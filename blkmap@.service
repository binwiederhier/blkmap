[Unit]
Description=blkmap block device %i
Documentation=https://heckel.io/blkmap
After=local-fs-pre.target
Before=local-fs.target
DefaultDependencies=no
# A crashed server's device pauses I/O until the restarted server re-attaches; if systemd
# gives up restarting, the reap unit deletes it so that I/O fails instead of waiting forever
StartLimitIntervalSec=60
StartLimitBurst=10
OnFailure=blkmap-reap@%i.service

[Service]
Type=notify
ExecStartPre=-/sbin/modprobe ublk_drv
ExecStart=/usr/bin/blkmap serve %i
Restart=on-failure
RestartSec=1
# Restarts go straight back to activating, so a crash does not count as a failure (which
# would trigger the reap unit before the restarted server could re-attach)
RestartMode=direct
# reload hands the device to a fresh server without disturbing it: the server re-executes
# the (possibly upgraded) binary in place and re-attaches. stop tears the device down. Exit
# 75 is the fallback if the re-exec fails: systemd starts a new server, which re-attaches.
ExecReload=/bin/kill -HUP $MAINPID
SuccessExitStatus=75
RestartForceExitStatus=75
# Stopping tears down the kernel device; give in-flight I/O time to drain
TimeoutStopSec=30
KillSignal=SIGTERM
# The server feeds the watchdog while every request completes within its stall limit (60 s).
# A stalled request makes it hand the device to a successor itself; the watchdog kills a
# server too wedged to do even that: the kernel requeues (or fails) the requests of a dead
# server, never those of a stuck one
WatchdogSec=60
# Root is needed for /dev/ublk-control, but nothing else: no setuid, no home directories,
# and the OOM killer should pick anything else first (I/O pauses until the restart)
NoNewPrivileges=yes
ProtectHome=yes
RestrictSUIDSGID=yes
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
