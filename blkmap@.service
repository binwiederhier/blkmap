[Unit]
Description=blkmap block device %i
Documentation=https://heckel.io/blkmap
After=local-fs-pre.target
Before=local-fs.target
DefaultDependencies=no
# Crash loops keep restarting (a dead server leaves a kernel device only a restart cleans up)
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
ExecStartPre=-/sbin/modprobe ublk_drv
ExecStart=/usr/bin/blkmap serve %i
Restart=on-failure
RestartSec=2
# Stopping tears down the kernel device; give in-flight I/O time to drain
TimeoutStopSec=30
KillSignal=SIGTERM
# Root is needed for /dev/ublk-control, but nothing else: no setuid, no home directories,
# and the OOM killer should pick anything else first (a server killed with I/O in flight
# leaves the kernel device wedged)
NoNewPrivileges=yes
ProtectHome=yes
RestrictSUIDSGID=yes
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
